@page "/productosvista"
@using FerreteriaStock.Services
@using FerreteriaStock.Models
@inject ProductoService ProductoService
@inject NavigationManager Nav

<div class="d-flex flex-column align-items-center overflow-auto"
     style="height:100%; padding: 20px;">

    <div class="card shadow-lg p-4 w-100 contenedor-productos"
         style="max-width: 1200px; border-radius: 15px;">

        <!-- Header -->
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h3 class="text-dark mb-0">
                <i class="bi bi-box-seam"></i> Gestión de Productos
            </h3>
            <button class="btn btn-success"
                    @onclick='() => Nav.NavigateTo("/productos/agregar")'>
                <i class="bi bi-plus-circle"></i> Agregar Producto
            </button>
        </div>

        <!-- 🔎 Buscador -->
        <div class="input-group mb-3">
            <span class="input-group-text"><i class="bi bi-search"></i></span>
            <InputText @bind-Value="busqueda" class="form-control" placeholder="Buscar producto..."
                       @oninput="FiltrarProductos" />
        </div>

        <!-- Mensajes -->
        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger">
                <i class="bi bi-exclamation-triangle"></i> @errorMessage
            </div>
        }

        @if (productosFiltrados == null)
        {
            <p><i class="bi bi-hourglass-split"></i> Cargando...</p>
        }
        else if (!productosFiltrados.Any())
        {
            <div class="alert alert-info">
                <i class="bi bi-info-circle"></i> No se encontraron productos.
            </div>
        }
        else
        {
            <!-- Grid de productos -->
            <div class="row">
                @foreach (var p in productosPaginaActual)
                {
                    <div class="col-md-4 col-lg-3 mb-4">
                        <div class="card shadow-sm h-100" style="border-radius: 12px;">
                            <div class="card-body d-flex flex-column text-center h-100">

                                <!-- Imagen fija -->
                                <div class="d-flex align-items-center justify-content-center mb-3"
                                     style="height:180px;">
                                    @if (!string.IsNullOrEmpty(p.Imagen))
                                    {
                                        <img src="@p.Imagen" alt="@p.Nombre"
                                             style="max-height:100%; max-width:100%; object-fit:contain;" />
                                    }
                                    else
                                    {
                                        <div class="text-muted d-flex align-items-center justify-content-center w-100 h-100"
                                             style="background:#f8f9fa; border-radius:8px;">
                                            <i class="bi bi-image" style="font-size: 2rem;"></i>
                                        </div>
                                    }
                                </div>

                                <!-- Info -->
                                <h5 class="card-title"><i class="bi bi-tag"></i> @p.Nombre</h5>
                                <p class="card-text text-muted flex-grow-1">
                                    <i class="bi bi-text-paragraph"></i> @p.Descripcion
                                </p>
                                <p><i class="bi bi-currency-dollar"></i> <b>@p.Precio.ToString("C")</b></p>
                                <p>
                                    <i class="bi bi-box"></i> Stock:
                                    <span class="badge bg-primary">@p.Stock</span>
                                </p>

                                <!-- Botones fijos -->
                                <div class="mt-auto d-flex justify-content-between">
                                    <button class="btn btn-sm btn-warning w-50 me-1"
                                            @onclick='() => Nav.NavigateTo($"/productos/editar/{p.Id}")'>
                                        <i class="bi bi-pencil"></i> Editar
                                    </button>
                                    <button class="btn btn-sm btn-danger w-50 ms-1"
                                            @onclick="() => ConfirmarEliminar(p.Id, p.Nombre)">
                                        <i class="bi bi-trash"></i> Eliminar
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <!-- 📄 Paginación -->
            <div class="d-flex justify-content-center align-items-center mt-3">
                <button class="btn btn-outline-primary me-2"
                        @onclick="PaginaAnterior"
                        disabled="@(paginaActual == 1)">
                    <i class="bi bi-arrow-left"></i> Anterior
                </button>

                <span class="mx-2">Página @paginaActual de @totalPaginas</span>

                <button class="btn btn-outline-primary ms-2"
                        @onclick="PaginaSiguiente"
                        disabled="@(paginaActual == totalPaginas)">
                    Siguiente <i class="bi bi-arrow-right"></i>
                </button>
            </div>
        }
    </div>

    <!-- Modal -->
    @if (mostrarModalEliminar)
    {
        <div class="modal fade show d-block" tabindex="-1"
             style="background-color:rgba(0,0,0,0.5);">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header bg-danger text-white">
                        <h5 class="modal-title">
                            <i class="bi bi-exclamation-octagon"></i> Confirmar eliminación
                        </h5>
                        <button type="button" class="btn-close" @onclick="CancelarEliminar"></button>
                    </div>
                    <div class="modal-body">
                        <p>¿Seguro que deseas eliminar el producto <b>@nombreProductoEliminar</b>?</p>
                    </div>
                    <div class="modal-footer">
                        <button class="btn btn-secondary" @onclick="CancelarEliminar">
                            <i class="bi bi-arrow-left-circle"></i> Cancelar
                        </button>
                        <button class="btn btn-danger" @onclick="EliminarProductoConfirmado">
                            <i class="bi bi-trash-fill"></i> Eliminar
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private List<Producto> productos = new();
    private List<Producto> productosFiltrados = new();
    private List<Producto> productosPaginaActual = new();
    private string busqueda = "";
    private string errorMessage = "";

    // Paginación
    private int paginaActual = 1;
    private int tamanioPagina = 8;
    private int totalPaginas = 1;

    // Modal
    private bool mostrarModalEliminar = false;
    private int productoIdEliminar;
    private string nombreProductoEliminar = "";

    protected override async Task OnInitializedAsync()
    {
        Console.WriteLine("[DEBUG] Entrando a OnInitializedAsync");
        await CargarProductos();
    }

    private async Task CargarProductos()
    {
        try
        {
            Console.WriteLine("[DEBUG] Llamando a GetProductosAsync...");
            productos = await ProductoService.GetProductosAsync() ?? new List<Producto>();
            Console.WriteLine($"[DEBUG] Productos recibidos: {productos.Count}");

            productosFiltrados = productos;
            CalcularPaginacion();
        }
        catch (Exception ex)
        {
            errorMessage = $"❌ Error al cargar productos: {ex.Message}";
            Console.WriteLine($"[DEBUG] Error en CargarProductos: {ex}");
            productos = new List<Producto>();
            productosFiltrados = productos;
        }
    }

    private void FiltrarProductos(ChangeEventArgs e)
    {
        busqueda = e.Value?.ToString() ?? "";

        if (string.IsNullOrWhiteSpace(busqueda))
        {
            productosFiltrados = productos;
        }
        else
        {
            productosFiltrados = productos
                .Where(p => (p.Nombre?.Contains(busqueda, StringComparison.OrdinalIgnoreCase) ?? false) ||
                            (p.Descripcion?.Contains(busqueda, StringComparison.OrdinalIgnoreCase) ?? false))
                .ToList();
        }

        paginaActual = 1;
        CalcularPaginacion();
    }

    private void CalcularPaginacion()
    {
        if (productosFiltrados == null || !productosFiltrados.Any())
        {
            productosPaginaActual = new List<Producto>();
            totalPaginas = 1;
            paginaActual = 1;
            return;
        }

        totalPaginas = (int)Math.Ceiling((double)productosFiltrados.Count / tamanioPagina);
        paginaActual = Math.Clamp(paginaActual, 1, totalPaginas);

        productosPaginaActual = productosFiltrados
            .Skip((paginaActual - 1) * tamanioPagina)
            .Take(tamanioPagina)
            .ToList();
    }

    private void PaginaAnterior()
    {
        if (paginaActual > 1)
        {
            paginaActual--;
            CalcularPaginacion();
        }
    }

    private void PaginaSiguiente()
    {
        if (paginaActual < totalPaginas)
        {
            paginaActual++;
            CalcularPaginacion();
        }
    }

    private void ConfirmarEliminar(int id, string nombre)
    {
        productoIdEliminar = id;
        nombreProductoEliminar = nombre;
        mostrarModalEliminar = true;
    }

    private async Task EliminarProductoConfirmado()
    {
        try
        {
            await ProductoService.DeleteProductoAsync(productoIdEliminar);
            mostrarModalEliminar = false;
            await CargarProductos();
        }
        catch (Exception ex)
        {
            errorMessage = $"❌ Error al eliminar producto: {ex.Message}";
            Console.WriteLine($"[DEBUG] Error al eliminar producto: {ex}");
        }
    }

    private void CancelarEliminar()
    {
        mostrarModalEliminar = false;
    }
}
