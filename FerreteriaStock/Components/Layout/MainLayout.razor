@using FerreteriaStock.Services
@inherits LayoutComponentBase
@inject NavigationManager Navigation
@inject SesionUsuario Sesion

<div class="d-flex">
    <!-- Sidebar -->
    <div class="sidebar p-3 bg-light" style="min-width:200px;">
        @if (Sesion.EstaLogueado)
        {
            <NavMenu />
            <button class="btn btn-danger mt-3 w-100" @onclick="CerrarSesion">
                <i class="bi bi-box-arrow-right"></i> Cerrar sesión
            </button>
        }
    </div>

    <!-- Contenido principal -->
    <main class="flex-grow-1 p-3">
        @Body
    </main>
</div>

@code {
    protected override void OnInitialized()
    {
        Sesion.OnCambioSesion += EstadoSesionCambio;
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            ValidarSesion();
        }
    }

    private void EstadoSesionCambio()
    {
        InvokeAsync(() =>
        {
            ValidarSesion();
            StateHasChanged();
        });
    }

    private void ValidarSesion()
    {
        var ruta = Navigation.ToBaseRelativePath(Navigation.Uri);

        if (!Sesion.EstaLogueado && 
            !ruta.StartsWith("login", StringComparison.OrdinalIgnoreCase) &&
            !string.IsNullOrWhiteSpace(ruta)) // evita redirección infinita
        {
            Navigation.NavigateTo("/login", forceLoad: true);
        }
    }

    private void CerrarSesion()
    {
        Sesion.CerrarSesion();
        Navigation.NavigateTo("/login", forceLoad: true);
    }

    public void Dispose()
    {
        Sesion.OnCambioSesion -= EstadoSesionCambio;
    }
}
